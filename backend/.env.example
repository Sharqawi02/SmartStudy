POSTGRES_DB=smartstudy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PORT=5001

OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.4-mini
# Keep false for free local generation. Set true when you want OpenAI to generate plan text.
OPENAI_PLAN_GENERATION_ENABLED=false
# Optional when using project-scoped keys or multiple orgs/projects.
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...
# OPENAI_TIMEOUT_SECONDS=30
